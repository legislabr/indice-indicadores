# Copie para .env e preencha os valores reais.
#   cp .env.example .env

# Host público do painel (usado pelo Traefik no docker-compose-prod.yaml)
PAINEL_HOST=painellegisla.hacklab.com.br

# Segredo aleatório para assinar cookies de sessão.
# Gere com:  openssl rand -hex 32
PAINEL_SECRET_KEY=troque-por-um-valor-aleatorio-forte

# Hash bcrypt da senha de acesso em BASE64 (recomendado: sem "$", evita
# problemas de interpolação do docker compose).
# Gere com:
#   docker compose run --rm painel python gerar_hash.py "sua senha aqui"
# e use a linha "PAINEL_SENHA_HASH_B64=..." impressa.
PAINEL_SENHA_HASH_B64=

# Legislatura padrão exportada
LEGISLATURA_ATUAL=57
